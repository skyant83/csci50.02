*******************************************************************************
* The following .include lines are necessary for all your CSCI 50.02 JSim
* exercises. These work like your Java import statement.
*
* TL;DR: Import area, do not touch.
*******************************************************************************

.include "8clocks.jsim"
.include "nominal.jsim"
.include "stdcell.jsim"


*******************************************************************************
* One-bit full adder built only from non-composite nand2 cells.
*******************************************************************************

.subckt fa a b carry_in sum carry_out
X1 a b n1 nand2
X2 a n1 n2 nand2
X3 b n1 n3 nand2
X4 n2 n3 n4 nand2

X5 n4 carry_in n5 nand2
X6 n4 n5 n6 nand2
X7 carry_in n5 n7 nand2
X8 n6 n7 sum nand2

X9 n1 n5 carry_out nand2
.ends


.subckt add32 a[31:0] b[31:0] cin0 sum[31:0] cout[31:30]
.connect cin0 carry0

Xfa a[31:0] b[31:0] carry[31:0] sum[31:0] carry[32:1] fa

.connect carry32 cout31
.connect carry31 cout30

.ends


*******************************************************************************
* Instantiate the 32-bit ripple-carry adder with no initial carry-in.
*******************************************************************************

Xsum a[31:0] b[31:0] 0 sum[31:0] c31 c30 add32


*******************************************************************************
* Required test cases, in order:
*   0x00000000 + 0x00000000 = 0x00000000
*   0x55555555 + 0x00000000 = 0x55555555
*   0x00000000 + 0x55555555 = 0x55555555
*   0x55555555 + 0x55555555 = 0xAAAAAAAA
*   0xFFFFFFFF + 0xFFFFFFFF = 0xFFFFFFFE
*   0xAAAAAAAA + 0x00000000 = 0xAAAAAAAA
*   0x00000000 + 0xAAAAAAAA = 0xAAAAAAAA
*   0xAAAAAAAA + 0xAAAAAAAA = 0x55555554
*   0x00000001 + 0xFFFFFFFF = 0x00000000
*   0xFFFFFFFF + 0x00000001 = 0x00000000
*
* The last two test cases have a long transition delay because they create a
* worst-case carry-propagate path through the 32-bit ripple-carry adder. Bit 0
* generates a carry, while bits 1 through 31 must use the carry produced by the
* preceding stage. Each affected sum therefore cannot settle until the required
* carry reaches it.
*
* 0xFFFFFFFF + 0xFFFFFFFF behaves differently. Since both operand bits are 1
* at every stage, each full adder generates a carry-out of 1 independently of
* its carry-in. These carries can be generated in parallel instead of traveling
* sequentially through all 32 stages.
*******************************************************************************

Wa a[31:0] nrz(0, 5, 20ns, 0ns, 0.001ns, 0.001ns)
+ 0x00000000 0x55555555 0x00000000 0x55555555 0xFFFFFFFF 0xAAAAAAAA 0x00000000 0xAAAAAAAA 0x00000001 0xFFFFFFFF

Wb b[31:0] nrz(0, 5, 20ns, 0ns, 0.001ns, 0.001ns)
+ 0x00000000 0x00000000 0x55555555 0x55555555 0xFFFFFFFF 0x00000000 0xAAAAAAAA 0xAAAAAAAA 0xFFFFFFFF 0x00000001

.tran 200ns
.plot a[31:0]
.plot b[31:0]
.plot sum[31:0]
.plot c30
.plot c31
