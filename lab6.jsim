.include "8clocks.jsim"
.include "nominal.jsim"
.include "stdcell.jsim"

*******************************************************************************
* join: connects two wires without adding a buffer gate.
*******************************************************************************
.subckt join s t
.connect s t
.ends

*******************************************************************************
* fa: two XORs calculate the sum; a mux selects the carry-out.
*******************************************************************************
.subckt fa a b c_in sum c_out
Xp a b p xor2
Xs p c_in sum xor2
Xc p a c_in c_out mux2
.ends

* add32: chain 32 full adders; each carry feeds the next bit.
.subckt add32 a[31:0] b[31:0] cin0 sum[31:0] cout[31:30]
.connect cin0 carry0

Xfa a[31:0] b[31:0] carry[31:0] sum[31:0] carry[32:1] fa

.connect carry32 cout31
.connect carry31 cout30
.ends

*******************************************************************************
* as32: op0 selects addition (0) or subtraction (1).
* Subtraction computes A + NOT B + 1; n, v, z mean negative, overflow, zero.
*******************************************************************************
.subckt as32 a[31:0] b[31:0] op0 fas[31:0] n v z
Xbx b[31:0] op0#32 bx[31:0] xor2
Xadd a[31:0] bx[31:0] op0 fas[31:0] cout[31:30] add32

.connect fas31 n
* Overflow is the XOR of carries into and out of the sign bit.
Xov cout31 cout30 v xor2

* Detect zero by checking all 32 result bits in groups of four.
Xnor fas[31:0:4] fas[30:0:4] fas[29:0:4] fas[28:0:4] nz[7:0] nor4
Xnd1 nz7 nz6 nz5 nz4 za nand4
Xnd2 nz3 nz2 nz1 nz0 zb nand4
Xz za zb z nor2
.ends

*******************************************************************************
* cmp32: n XOR v gives signed less-than; z gives equality.
* op1 enables equality and op2 enables less-than; upper result bits are zero.
*******************************************************************************
.subckt cmp32 n v z op[2:1] fcmp[31:0]
Xlt n v lt xor2
Xeq op1 z eqn nand2
Xless op2 lt lessn nand2
Xres eqn lessn fcmp0 nand2

Xzero zero constant0
Xgnd zero#31 fcmp[31:1] join
.ends

*******************************************************************************
* bool32: does AND, OR, XOR, etc. on every bit of a and b.
* For each bit, a and b pick one of four "op" bits (a "truth table"):
*   a b = 00 -> op0,  10 -> op1,  01 -> op2,  11 -> op3
* Changing op changes the function: 1000 = AND, 1110 = OR, 0110 = XOR.
* One small mux4 per bit does all of it, so it is small and simple.
*******************************************************************************
.subckt bool32 a[31:0] b[31:0] op[3:0] fbool[31:0]
Xmux a[31:0] b[31:0] op0#32 op1#32 op2#32 op3#32 fbool[31:0] mux4
.ends

*******************************************************************************
* shift32: B[4:0] sets the distance; op selects left, right, or signed right.
* Signed right shifts repeat a31; the specified logical modes insert zero.
*******************************************************************************
.subckt shift32 a[31:0] b[4:0] op[1:0] fshift[31:0]
Xfill op1 a31 fill and2

*******************************************************************************
* For a left shift, reverse the input bits so the same right shifter can be used.
*******************************************************************************
Xrin op0#32 a[0:31] a[31:0] xr[31:0] mux2

*******************************************************************************
* Five mux stages optionally shift by 16, 8, 4, 2, and 1 bit.
*******************************************************************************
Xs4 b4#32 xr[31:0] fill#16 xr[31:16] ya[31:0] mux2
Xs3 b3#32 ya[31:0] fill#8 ya[31:8] yb[31:0] mux2
Xs2 b2#32 yb[31:0] fill#4 yb[31:4] yc[31:0] mux2
Xs1 b1#32 yc[31:0] fill#2 yc[31:2] yd[31:0] mux2
Xs0 b0#32 yd[31:0] fill yd[31:1] ye[31:0] mux2

*******************************************************************************
* Reverse the output back for a left shift; right shifts keep the bit order.
*******************************************************************************
Xrout op0#32 ye[0:31] ye[31:0] fshift[31:0] mux2
.ends

*******************************************************************************
* alu32: calculate arithmetic, comparison, and shift results in parallel.
*******************************************************************************
.subckt alu32 a[31:0] b[31:0] alufn[5:0] f[31:0]
Xas a[31:0] b[31:0] alufn0 fas[31:0] n v z as32
Xcmp n v z alufn[2:1] fcmp[31:0] cmp32
Xshift a[31:0] b[4:0] alufn[1:0] fshift[31:0] shift32

*******************************************************************************
* The top two alufn bits select arithmetic (00), Boolean (01),
* shift (10), or comparison (11).
*******************************************************************************
Xna5 alufn5 nalu5 inverter
Xna4 alufn4 nalu4 inverter
Xsas alufn5 alufn4 selas nor2
Xssh nalu5 alufn4 selsh nor2
Xscm alufn5 alufn4 selcmp and2
Xsbl alufn5 nalu4 selbl nor2

*******************************************************************************
* Gate four truth-table bits instead of 32 Boolean output bits.
* When selected, bool32 produces the inverted result (fbooln).
* When disabled, it produces all ones, which are neutral at the final NANDs.
*******************************************************************************
Xtt alufn[3:0] selbl#4 tt[3:0] nand2
Xbool a[31:0] b[31:0] tt[3:0] fbooln[31:0] bool32

*******************************************************************************
* Gate the other results, then use final NANDs to select the active family.
* Only bit 0 needs the comparison result; its upper bits are always zero.
*******************************************************************************
Xtas fas[31:0] selas#32 tas[31:0] nand2
Xtsh fshift[31:0] selsh#32 tsh[31:0] nand2
Xtcm fcmp0 selcmp tcm nand2

Xf1 tas[31:1] tsh[31:1] fbooln[31:1] f[31:1] nand3
Xf0 tas0 tsh0 tcm fbooln0 f0 nand4
.ends

Xalu a[31:0] b[31:0] alufn[5:0] f[31:0] alu32

*******************************************************************************
* One ALU is tested with 39 operand pairs: each pair lasts 20 ns,
* and each operation lasts 60 ns. Read settled values near the end of a slot.
*******************************************************************************
Wa a[31:0] nrz(0v,5.0v,20ns,0ns,.1ns,.1ns)
+ -1 0x55555555 0xAAAAAAAA 1 -2 -1 -1 0x55555555 0 -1 0x55555555 0
+ -1 0x55555555 0 -1 0x55555555 0 -1 0x55555555 0 1 -1 -1 0x55555555 0xAAAAAAAA -1
+ 0x55555555 0xAAAAAAAA -1 -1 15 0 -1 15 0 -1 15 0

Wb b[31:0] nrz(0v,5.0v,20ns,0ns,.1ns,.1ns)
+ 1 0x55555555 0xAAAAAAAA 1 0 -1 -1 0xAAAAAAAA 0 -1 0xAAAAAAAA 0
+ -1 0xAAAAAAAA 0 -1 0xAAAAAAAA 0 -1 0xAAAAAAAA 0 31 15 0 24 24 31
+ 24 24 31 1 15 -256 1 15 -256 1 15 -256

Wf alufn[5:0] nrz(0v,5.0v,60ns,0ns,.1ns,.1ns)
+ 0 1 24 30 22 26 21 32 33 35 51 53 55

.tran 780ns
.plot sd(alufn[5:0])
.plot sd(a[31:0])
.plot sd(b[31:0])
.plot sd(f[31:0])