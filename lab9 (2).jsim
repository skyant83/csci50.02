*******************************************************************************

*******************************************************************************

*******************************************************************************
.subckt join S T
.connect S T
.ends

*******************************************************************************

*******************************************************************************
Xjcontrola control[13:12] pcsel[1:0] join
Xjcontrolb control11      ra2sel     join
Xjcontrolc control10      bsel       join
Xjcontrold control[9:8]   wdsel[1:0] join
Xjcontrole control[7:2]   alufn[5:0] join
Xjcontrolf control1       wr_        join
Xjcontrolg control0       werf_      join

*******************************************************************************

*******************************************************************************
Xjinsta inst[31:26] opcode[5:0] join
Xjinstb inst[25:21] rc[4:0]     join
Xjinstc inst[20:16] ra[4:0]     join
Xjinstd inst[15:11] rb[4:0]     join
Xjinste inst[15:0]  c[15:0]     join

*******************************************************************************

*******************************************************************************

*******************************************************************************

.connect clk2 clk

Vreset reset 0 pulse(5,0,11ns,.1ns,.1ns,100000ns)

.connect 0 gnd

.subckt fa a b c_in sum c_out
Xp a b p xor2
Xs p c_in sum xor2
Xc p a c_in c_out mux2
.ends

.subckt add7 a[6:0] b[6:0] cin s[6:0]
.connect cin cc0
Xfa a[6:0] b[6:0] cc[6:0] s[6:0] cc[7:1] fa
.ends

.subckt add32 a[31:0] b[31:0] cin0 sum[31:0] cout[31:30]
.connect cin0 carry0

Xfa a[31:0] b[31:0] carry[31:0] sum[31:0] carry[32:1] fa

.connect carry32 cout31
.connect carry31 cout30
.ends

*******************************************************************************

*******************************************************************************
.subckt as32 a[31:0] b[31:0] op0 fas[31:0] n v z
Xbx b[31:0] op0#32 bx[31:0] xor2
Xadd a[31:0] bx[31:0] op0 fas[31:0] cout[31:30] add32

.connect fas31 n
Xov cout31 cout30 v xor2

Xnor fas[31:0:4] fas[30:0:4] fas[29:0:4] fas[28:0:4] nz[7:0] nor4
Xnd1 nz7 nz6 nz5 nz4 za nand4
Xnd2 nz3 nz2 nz1 nz0 zb nand4
Xz za zb z nor2
.ends

*******************************************************************************

*******************************************************************************
.subckt cmp32 n v z op[2:1] fcmp[31:0]
Xlt n v lt xor2
Xeq op1 z eqn nand2
Xless op2 lt lessn nand2
Xres eqn lessn fcmp0 nand2

Xzero zero constant0
Xgnd zero#31 fcmp[31:1] join
.ends

*******************************************************************************

*******************************************************************************
.subckt bool32 a[31:0] b[31:0] op[3:0] fbool[31:0]
Xmux a[31:0] b[31:0] op0#32 op1#32 op2#32 op3#32 fbool[31:0] mux4
.ends

*******************************************************************************

*******************************************************************************
.subckt shift32 a[31:0] b[4:0] op[1:0] fshift[31:0]
Xfill op1 a31 fill and2

Xrin op0#32 a[0:31] a[31:0] xr[31:0] mux2

Xs4 b4#32 xr[31:0] fill#16 xr[31:16] ya[31:0] mux2
Xs3 b3#32 ya[31:0] fill#8 ya[31:8] yb[31:0] mux2
Xs2 b2#32 yb[31:0] fill#4 yb[31:4] yc[31:0] mux2
Xs1 b1#32 yc[31:0] fill#2 yc[31:2] yd[31:0] mux2
Xs0 b0#32 yd[31:0] fill yd[31:1] ye[31:0] mux2

Xrout op0#32 ye[0:31] ye[31:0] fshift[31:0] mux2
.ends

*******************************************************************************

*******************************************************************************
.subckt alu32 a[31:0] b[31:0] alufn[5:0] f[31:0]
Xas a[31:0] b[31:0] alufn0 fas[31:0] n v z as32
Xcmp n v z alufn[2:1] fcmp[31:0] cmp32
Xshift a[31:0] b[4:0] alufn[1:0] fshift[31:0] shift32

Xna5 alufn5 nalu5 inverter
Xna4 alufn4 nalu4 inverter
Xsas alufn5 alufn4 selas nor2
Xssh nalu5 alufn4 selsh nor2
Xscm alufn5 alufn4 selcmp and2
Xsbl alufn5 nalu4 selbl nor2

Xtt alufn[3:0] selbl#4 tt[3:0] nand2
Xbool a[31:0] b[31:0] tt[3:0] fbooln[31:0] bool32

Xtas fas[31:0] selas#32 tas[31:0] nand2
Xtsh fshift[31:0] selsh#32 tsh[31:0] nand2
Xtcm fcmp0 selcmp tcm nand2

Xf1 tas[31:1] tsh[31:1] fbooln[31:1] f[31:1] nand3
Xf0 tas0 tsh0 tcm fbooln0 f0 nand4
.ends

Xpcinc pc[8:2] gnd#6 vdd gnd pc4[8:2] add7
Xpcbr  pc4[8:2] c[6:0] gnd bt[8:2] add7

Xpcsel pcsel0#7 pcsel1#7 pc4[8:2] bt[8:2] rd1_[8:2] pc[8:2] pcn[8:2] mux4

Xpcrst reset#7 pcn[8:2] gnd#7 pcd[8:2] mux2
Xpcreg pcd[8:2] clk#7 pc[8:2] dreg
.connect 0 pc[1:0]

Xjra  ra[4:0] ra1_[4:0] join
Xjwa  rc[4:0] wa[4:0]   join
Xra2  ra2sel#5 rb[4:0] rc[4:0] ra2_[4:0] mux2

Xznor rd1_[31:0:4] rd1_[30:0:4] rd1_[29:0:4] rd1_[28:0:4] zn[7:0] nor4
Xznd1 zn7 zn6 zn5 zn4 za nand4
Xznd2 zn3 zn2 zn1 zn0 zb nand4
Xzout za zb z nor2

Xbsel bsel#32 rd2_[31:0] c15#16 c[15:0] bb[31:0] mux2
Xalu  rd1_[31:0] bb[31:0] alufn[5:0] alu[31:0] alu32
Xjmem alu[8:0] mema[8:0] join
Xjmwd rd2_[31:0] memwd[31:0] join

Xwdsel wdsel0#32 wdsel1#32 gnd#23 pc4[8:2] gnd#2 alu[31:0] memrd[31:0] alu[31:0] wd[31:0] mux4

*******************************************************************************

*******************************************************************************
Xjdisplaya ra2_b_wdsel[3:0] ra2sel bsel wdsel[1:0] join
Xjdisplayb wr_werf[1:0]     wr werf                join

*******************************************************************************

*******************************************************************************
.tran 1280ns
.plot clk
.plot reset
.plot pc[8:0]
.plot betaop(opcode[5:0])
.plot d(ra[4:0])
.plot d(rb[4:0])
.plot d(rc[4:0])
.plot sd(c[15:0])
.plot b(pcsel[1:0])
.plot b(ra2_b_wdsel[3:0])
.plot b(alufn[5:0])
.plot b(wr_werf[1:0])
.plot werf
.plot sd(rd1_[31:0])
.plot sd(rd2_[31:0])
.plot sd(wd[31:0])
.plot d(mema[8:0])
.plot sd(memrd[31:0])
.plot sd(memwd[31:0])
