| R1 FIBO ADDRESS POINTER
| R2 CURR FIBO NUMBER
| R3 NEXT FIBO NUMBER
| R4 TEMP ADD REGISTER

.include /beta.uasm

LD(INPUT, R0)
CMOVE(FIBO, R1)
CMOVE(0, R2)
CMOVE(1, R3)

LOOP:
  BEQ(R0, DONE)

  ST(R2, 0, R1)

  ADD(R2, R3, R4)
  MOVE(R3, R2)
  MOVE(R4, R3)

  ADDC(R1, 4, R1)
  SUBC(R0, 1, R0)
  BR(LOOP)

DONE:
  HALT()

. = 0x19C
INPUT: LONG(20)

. = . + 0x04
FIBO: